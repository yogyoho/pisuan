{
  "template_id": "TPL_HEADER_CONCLUSION_01",
  "name": "结论与建议",
  "category": "header",
  "domain": "coal_mining",
  "priority": 80,
  "match_rule": {
    "strategy": "regex_anchor",
    "regex": "^(?P<chapter_id>\\d+(?:\\.\\d+)*)\\s*(?P<topic_text>.*(结论|结论与建议|总结|综合结论|建议).*)$",
    "confidence_threshold": 0.74,
    "fallback_keywords": ["结论", "建议", "总结", "综合结论"]
  },
  "generalized_pattern": "[SECTION] {{chapter_id}} {{topic_text}}",
  "slots": [
    {
      "name": "chapter_id",
      "description": "章节编号",
      "type": "String",
      "is_variable": true,
      "extraction_pattern": "\\d+(?:\\.\\d+)*"
    },
    {
      "name": "topic_text",
      "description": "结论建议主题文本",
      "type": "String",
      "is_anchor": true,
      "semantic_check": ["结论", "建议", "总结", "综合结论"],
      "semantic_category": "conclusion"
    }
  ],
  "semantic_routing": {
    "standard_code": "SEC_CONCLUSION",
    "category": "Conclusion",
    "required_skills": [
      "skill_conclusion_summarizer",
      "skill_approval_condition_extract"
    ],
    "context_prompt_ref": ""
  },
  "metadata": {
    "version": "1.0",
    "tags": ["结论", "建议", "章节标题"],
    "priority": 80
  }
}


