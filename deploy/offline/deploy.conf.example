# ── Yuxi 离线部署 · 唯一需要手写的配置 ─────────────────────
# 用法：cp deploy.conf.example deploy.conf 后逐项填写，再执行 ./install.sh

# 对外 Web 端口（生产 Web 入口，默认 80）
YUXI_WEB_PORT=80

# 种子管理员（首次部署自动创建；首登即改密）
YUXI_SEED_SUPERADMIN_UID=admin
YUXI_SEED_SUPERADMIN_NAME=系统管理员
# 必填
YUXI_SEED_SUPERADMIN_PASSWORD=
# 必填（批量默认账号初始密码）
YUXI_SEED_DEFAULT_USER_PASSWORD=

# 环评 refs 本地 Gitea 管理账号密码（refsadmin）
# 必填（prod compose :? 强制校验，缺失 compose 拒绝启动）
GITEA_REFS_PASSWORD=

# ── 开关 ──
# false=不启动观测栈
ENABLE_LANGFUSE=true
