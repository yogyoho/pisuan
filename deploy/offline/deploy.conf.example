# ── Pisuan 离线部署 · 唯一需要手写的配置 ─────────────────────
# 用法：cp deploy.conf.example deploy.conf 后逐项填写，再执行 ./install.sh

# 对外 Web 端口（生产 Web 入口，默认 80）
PISUAN_WEB_PORT=80

# 种子管理员（仅对全新空库生效；本包含预置数据快照→库已初始化，seed 自动跳过）
PISUAN_SEED_SUPERADMIN_UID=admin
PISUAN_SEED_SUPERADMIN_NAME=系统管理员
# 必填
PISUAN_SEED_SUPERADMIN_PASSWORD=
# 必填（批量默认账号初始密码）
PISUAN_SEED_DEFAULT_USER_PASSWORD=

# 环评 refs 本地 Gitea 管理账号密码（refsadmin）
# 必填（prod compose :? 强制校验，缺失 compose 拒绝启动）
GITEA_REFS_PASSWORD=

# ── 开关 ──
# Langfuse 观测栈镜像未随离线包交付（启用需自备下列 LICENSES §3 镜像并 docker load）；默认关闭
ENABLE_LANGFUSE=false
